{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "park-test": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "park-test",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {}
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MAP_DEBUG": "1"
      },
      "ios": {}
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "ios": {}
    }
  },
  "submit": {
    "production": {}
  }
}
