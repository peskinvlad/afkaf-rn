+// afkaf patch (patch-package): under the New Architecture this view is mounted
+// through the legacy-interop layer, which never calls reactSetFrame above —
+// whenever the marker's layout metrics change it assigns
+// `contentView.frame = {0, 0, w, h}` directly. Once MapKit owns this view
+// (`map` is set in viewForAnnotation) that throws away the centre MapKit put
+// it at, and the marker jumps across the map until MapKit next lays it out.
+// Route that zero-origin assignment through reactSetFrame, which keeps the
+// centre and adopts only the size — the same behaviour as on Paper. MapKit
+// itself positions annotation views through `center`, so it never lands here.
+- (void)setFrame:(CGRect)frame
+{
+    if (self.map != nil && CGPointEqualToPoint(frame.origin, CGPointZero)) {
+        [self reactSetFrame:frame];
+        return;
+    }
+    [super setFrame:frame];
+}
